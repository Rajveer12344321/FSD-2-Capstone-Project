# Copy to .env (docker compose reads it) and change the values before sharing a deployment.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=admin@bloodbridge.local
ADMIN_PASSWORD=choose-a-strong-password
SEED_DEMO_DATA=true
# Optional email delivery (otherwise in-app notifications are the delivery channel):
# EMAIL_ENABLED=true
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=no-reply@yourdomain
